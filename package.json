{
  "name": "horatio-doctoral-research",
  "version": "2.0.0",
  "description": "Horatio \u2014 Guided University Research Utility \u00b7 Doctoral Research Intelligence",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "prebuild": "vite build",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "author": {
    "name": "Dhiraj Varma",
    "email": "vdhiraj2@gmail.com"
  },
  "build": {
    "appId": "com.horatio.doctoral-research",
    "productName": "Horatio",
    "copyright": "Copyright \u00a9 2026 Dhiraj Varma",
    "icon": "icon.png",
    "files": [
      "main.js",
      "dist/web/**/*",
      "icon.png",
      "!src/**",
      "!public/**",
      "!index.html",
      "!vite.config.js",
      "!test-functional.py",
      "!screenshot.py",
      "!docs/**",
      "!*.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "description": "Horatio \u2014 Guided University Research Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "nsis": {
      "shortcutName": "Horatio",
      "artifactName": "Horatio-V2-Setup.exe"
    }
  },
  "dependencies": {
    "terser": "^5.46.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.13"
  }
}